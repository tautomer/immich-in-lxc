# Source installation settings (see README.md).
# Review the target release's upgrade notes before changing REPO_TAG.
# .env is sourced by Bash; quote values containing shell metacharacters.
REPO_TAG=v3.3.3
INSTALL_DIR=/home/immich
UPLOAD_DIR=/home/immich/upload
# CPU=false, CUDA=true, Intel=openvino, AMD=rocm
isCUDA=false
PROXY_NPM=
PROXY_NPM_DIST=
# Used by uv bootstrap/default index or historical Poetry releases.
PROXY_POETRY=

# Optional source-build override: Immich <3.3 needs python3.11 (Poetry);
# Immich 3.3+ needs Python >=3.12 and defaults to python3.12 (uv).
# Install matching venv/dev support first. Python 3.13 is optional for 3.3+.
# Prebuilt venvs require /usr/bin/python3.11 (<3.3) or python3.12 (3.3+).
# Never repoint a prebuilt venv to a different interpreter version.
ML_PYTHON=
